# Package-local ignore list for GNU Stow.
# Keep the default noise ignores because a package-local ignore file replaces
# Stow's built-in default ignore list.

RCS
.+,v

CVS
\.\#.+
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~
\#.*\#

^/README.*
^/LICENSE.*
^/COPYING

# Git templates cannot use relative symlinks generated by stow --no-folding,
# because git init/clone copies template symlinks verbatim into repos
# where the relative path ../../../../dotfiles/... is invalid and breaks tools
# (including OpenCode snapshots).
^/\.config/git/git_template$
