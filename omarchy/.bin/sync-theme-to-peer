#!/usr/bin/env bash

set -u

if [[ ${OMARCHY_THEME_SYNC:-0} == 1 ]]; then
  exit 0
fi

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo "Usage: sync-theme-to-peer [theme-name]"
  exit 0
fi

theme_name=${1:-$(<"$HOME/.local/state/omarchy/current/theme.name")}
if [[ ! $theme_name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid Omarchy theme name: $theme_name" >&2
  exit 1
fi

case "$(hostname -s)" in
  omarchy)
    peer=omarchy-0xdev
    ;;
  omarchy-0xdev)
    peer=omarchy
    ;;
  *)
    exit 0
    ;;
esac

ssh \
  -o BatchMode=yes \
  -o ConnectTimeout=3 \
  "$peer" \
  "OMARCHY_THEME_SYNC=1 bash -lc '[[ \$(<~/.local/state/omarchy/current/theme.name) == \$1 ]] || omarchy theme set \"\$1\"' _ '$theme_name'" \
  >/dev/null 2>&1 &
