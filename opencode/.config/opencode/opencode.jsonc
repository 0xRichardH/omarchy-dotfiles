{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md",
  ],
  "autoupdate": false,
  "plugin": [],
  "lsp": false,
  "provider": {
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "exa-mcp-server",
        "tools=get_code_context_exa,web_search_exa",
      ],
      "environment": {
        "EXA_API_KEY": "{file:~/.credentials/exa_api_key}",
      },
      "enabled": true,
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },
}
